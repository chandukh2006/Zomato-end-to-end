# ============================================================
# Docker Environment Variables
# ============================================================
# 1. Copy this file:  cp .env.docker.example .env.docker
# 2. Rename .env.docker.example to .env.docker (or copy contents)
# 3. Replace placeholder values below with your actual values
# 4. DO NOT commit .env.docker to version control (it contains secrets)
# ============================================================

# --- REQUIRED: Google Maps API Key ---
# Get from: https://console.cloud.google.com/
# Enable "Geocoding API", then create an API key
# Use the SAME key for both variables below
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-api-key-here

# --- Backend ---
SECRET_KEY=your-secret-key-minimum-32-chars-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Frontend (keep as below for local run) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
